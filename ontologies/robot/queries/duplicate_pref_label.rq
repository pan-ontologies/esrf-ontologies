# # Duplicate Preferred Label
#
# **Problem:** Two different entities have the same skos:prefLabel.
#
# **Solution:** Make the preferred labels unique.

PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT DISTINCT ?entity ?property ?value WHERE {
  VALUES ?property { skos:prefLabel }
  ?entity ?property ?value .
  ?entity2 ?property ?value2 .
  FILTER (?entity != ?entity2)
  FILTER (LCASE(str(?value)) = LCASE(str(?value2)))
  FILTER (!isBlank(?entity))
  FILTER (!isBlank(?entity2))
  FILTER NOT EXISTS { ?entity owl:deprecated true .
                      ?entity2 owl:deprecated true }
}
ORDER BY ?value
